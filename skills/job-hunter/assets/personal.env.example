# Template for $XDG_CONFIG_HOME/job-hunter/secrets/personal.env
#
# After running `job init`, this file is copied to ~/.config/job-hunter/secrets/personal.env
# and chmod'd 600. Edit there, never here. THIS FILE IS THE ONLY ONE THE MODEL READS;
# values stay empty so they are safe to ship in the repo.
#
# Every key the bundled adapters can reference is listed here. Adding a new
# adapter that needs a new secret? Add the key here too (empty value) so the
# resolver fails loudly at fill-plan time, never at submit time.

# ─── Identity ────────────────────────────────────────────────────────────────
JOB_HUNTER_FULL_NAME=
JOB_HUNTER_CPF=
JOB_HUNTER_RG=
JOB_HUNTER_BIRTH_DATE=

# ─── Contact ─────────────────────────────────────────────────────────────────
JOB_HUNTER_PHONE=
JOB_HUNTER_ADDRESS_LINE1=
JOB_HUNTER_ADDRESS_LINE2=
JOB_HUNTER_CITY=
JOB_HUNTER_STATE=
JOB_HUNTER_POSTAL_CODE=
JOB_HUNTER_COUNTRY=

# ─── Financial ───────────────────────────────────────────────────────────────
JOB_HUNTER_SALARY_EXPECTATION_BRL=
JOB_HUNTER_SALARY_EXPECTATION_USD=
JOB_HUNTER_BANK_ACCOUNT=

# ─── Session credentials (access, not identity) ──────────────────────────────
LINKEDIN_LI_AT=
GUPY_SESSION_COOKIE=
