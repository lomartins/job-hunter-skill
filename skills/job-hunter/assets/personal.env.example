# Template for $XDG_CONFIG_HOME/job-hunter/secrets/personal.env
#
# After running `job init`, this file is copied to ~/.config/job-hunter/secrets/personal.env
# and chmod'd 600. Edit there, never here. THIS FILE IS THE ONLY ONE THE MODEL READS;
# values stay empty so they are safe to ship in the repo.
#
# Every key the bundled adapters can reference is listed here. Adding a new
# adapter that needs a new secret? Add the key here too (empty value) so the
# resolver fails loudly at fill-plan time, never at submit time.

# ─── Identity ────────────────────────────────────────────────────────────────
JOB_HUNTER_FULL_NAME=
JOB_HUNTER_CPF=
JOB_HUNTER_RG=
JOB_HUNTER_BIRTH_DATE=

# ─── Contact ─────────────────────────────────────────────────────────────────
JOB_HUNTER_PHONE=
JOB_HUNTER_ADDRESS_LINE1=
JOB_HUNTER_ADDRESS_LINE2=
JOB_HUNTER_CITY=
JOB_HUNTER_STATE=
JOB_HUNTER_POSTAL_CODE=
JOB_HUNTER_COUNTRY=

# ─── Financial ───────────────────────────────────────────────────────────────
JOB_HUNTER_SALARY_EXPECTATION_BRL=
JOB_HUNTER_SALARY_EXPECTATION_USD=
JOB_HUNTER_BANK_ACCOUNT=

# ─── Session credentials (access, not identity) ──────────────────────────────
LINKEDIN_LI_AT=
GUPY_SESSION_COOKIE=

# Glassdoor — capture after logging in at glassdoor.com.
# Both cookies required. See references/sources/glassdoor.md.
GLASSDOOR_GD_ID=
GLASSDOOR_UAC=

# Indeed — optional. Listings work anonymously but a session helps avoid captcha.
# Capture `CTK` cookie value from br.indeed.com after solving any captcha.
INDEED_CTK=

# ─── Firecrawl (optional; opt-in scraping backend for Indeed + Glassdoor) ────
# Setting FIRECRAWL_ENDPOINT enables Firecrawl as the HTTP transport for the
# two captcha-heavy sources. Self-hosted Docker is recommended — see
# references/firecrawl.md for compose + privacy notes.
# Apply path is hard-disabled when this is set (PII safety).
FIRECRAWL_ENDPOINT=
FIRECRAWL_API_KEY=
